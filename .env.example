# Copy this file to `.env.local` and fill in real values.
# All VITE_* variables are exposed to the client bundle — never put secrets here.

# Your app's Client ID from the Shopify Partner Dashboard (Apps > your app > Configuration).
VITE_SHOPIFY_API_KEY=your_app_client_id_here

# Base URL of the existing backend API this dashboard calls.
# e.g. https://api.yourbackend.com
VITE_API_BASE_URL=https://api.example.com
